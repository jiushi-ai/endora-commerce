const emptyDiv = $("<div>")

const MOBILE_MAX_WIDTH = 1023;
const DESKTOP_GRID_COLUMNS = 4;
const TRIGGER_SELECTOR = "#nv-cs-item .nav-cs-link, #nv-cs-item-mob .nav-cs-link";
const MODAL_ID = "country-selector-modal";

function isMobileViewport() {
  return $(window).width() <= MOBILE_MAX_WIDTH;
}

function getTriggers() {
  return $(TRIGGER_SELECTOR);
}

function isModalOpen() {
  const modal = document.getElementById(MODAL_ID);
  return modal && modal.classList.contains("cs-active");
}

function setTriggerExpanded(expanded) {
  getTriggers().attr("aria-expanded", expanded ? "true" : "false");
}

function setupModalA11y() {
  const modal = document.getElementById(MODAL_ID);
  if (!modal) {
    return;
  }
  modal.setAttribute("role", "dialog");
  modal.setAttribute("aria-modal", "true");
  const titleEl = modal.querySelector(".cs-title");
  if (titleEl) {
    if (!titleEl.id) {
      titleEl.id = "country-selector-modal-title";
    }
    modal.setAttribute("aria-labelledby", titleEl.id);
  }
  $(".cs-overlay").attr({ "aria-hidden": "true", tabindex: "-1" });
}

function enhanceRegionSections() {
  $("#country-selector-modal .region-section").each(function (index, section) {
    const $section = $(section);
    const $title = $section.find(".region-title").first();
    const $list = $section.find("ul").first();
    if (!$title.length || !$list.length) {
      return;
    }
    const listId = $list.attr("id") || "cs-region-list-" + index;
    $list.attr("id", listId);
    if (isMobileViewport()) {
      $title.attr({
        role: "button",
        tabindex: "0",
        "aria-expanded": $title.hasClass("cs-active") ? "true" : "false",
        "aria-controls": listId,
      });
    } else {
      $title.removeAttr("role tabindex aria-expanded aria-controls");
    }
  });
}

function toggleRegion($title) {
  if ($title.hasClass("cs-active")) {
    $title.removeClass("cs-active").attr("aria-expanded", "false");
    $title.children("svg").removeClass("svg-open");
    $title.siblings("ul").removeClass("show-cs-submenu");
  } else {
    $(".region-title").removeClass("cs-active").attr("aria-expanded", "false");
    $(".region-title svg.svg-open").removeClass("svg-open");
    $(".region-title").siblings("ul").removeClass("show-cs-submenu");
    $title.addClass("cs-active").attr("aria-expanded", "true");
    $title.children("svg").addClass("svg-open");
    $title.siblings("ul").addClass("show-cs-submenu");
  }
}

function getModalNavigableItems() {
  const items = [];
  $("#country-selector-modal .region-section").each(function () {
    const $section = $(this);
    const $title = $section.find(".region-title").first();
    if ($title.attr("role") === "button") {
      items.push($title[0]);
    }
    $section.find(".country-locale-name a").each(function () {
      items.push(this);
    });
  });
  return $(items);
}

function ensureLocaleLinkAccessible($link) {
  const $ul = $link.closest("ul");
  if ($ul.length && !$ul.is(":visible")) {
    const $title = $link.closest(".region-section").find(".region-title").first();
    if ($title.length && !$title.hasClass("cs-active")) {
      toggleRegion($title);
    }
  }
}

function focusModalItemAt(index) {
  const $items = getModalNavigableItems();
  if (!$items.length) {
    return;
  }
  const normalizedIndex =
    ((index % $items.length) + $items.length) % $items.length;
  const $target = $items.eq(normalizedIndex);
  if ($target.is("a")) {
    ensureLocaleLinkAccessible($target);
  }
  $target.focus();
}

function focusFirstModalItem() {
  if (isMobileViewport()) {
    focusModalItemAt(0);
    return;
  }
  const $firstSection = getRegionSections().first();
  const $firstLink = getVisibleRegionLinks($firstSection).first();
  if ($firstLink.length) {
    focusLink($firstLink);
  }
}

function focusLink($link) {
  if ($link && $link.length) {
    ensureLocaleLinkAccessible($link);
    $link.focus();
  }
}

function getRegionSections() {
  return $("#country-selector-modal .region-section");
}

function getVisibleRegionLinks($section) {
  return $section.find(".country-locale-name a").filter(function () {
    const $link = $(this);
    return $link.is(":visible") && $link.closest("ul").is(":visible");
  });
}

function keyToDirection(key) {
  if (key === "ArrowDown" || key === "Down") {
    return "down";
  }
  if (key === "ArrowUp" || key === "Up") {
    return "up";
  }
  if (key === "ArrowLeft" || key === "Left") {
    return "left";
  }
  if (key === "ArrowRight" || key === "Right") {
    return "right";
  }
  return null;
}

function navigateMobileLinear(direction) {
  const $items = getModalNavigableItems();
  if (!$items.length) {
    return;
  }
  const active = document.activeElement;
  let idx = $items.index(active);
  if (idx < 0) {
    focusModalItemAt(0);
    return;
  }
  if (direction === "down" || direction === "right") {
    focusModalItemAt(idx + 1);
  } else if (direction === "up" || direction === "left") {
    if (idx <= 0) {
      getTriggers().first().focus();
    } else {
      focusModalItemAt(idx - 1);
    }
  }
}

function navigateDesktopGrid(direction) {
  const active = document.activeElement;
  const $active = $(active);

  if (!$active.is("#country-selector-modal .country-locale-name a")) {
    focusFirstModalItem();
    return;
  }

  const $section = $active.closest(".region-section");
  const $links = getVisibleRegionLinks($section);
  const idx = $links.index(active);
  const cols = DESKTOP_GRID_COLUMNS;
  const col = idx % cols;
  const sections = getRegionSections();
  const sectionIdx = sections.index($section[0]);
  let targetIdx = idx;

  if (direction === "right") {
    if (idx + 1 < $links.length) {
      targetIdx = idx + 1;
    } else if (sectionIdx + 1 < sections.length) {
      const $nextLinks = getVisibleRegionLinks($(sections[sectionIdx + 1]));
      if ($nextLinks.length) {
        focusLink($nextLinks.first());
        return;
      }
    }
  } else if (direction === "left") {
    if (idx > 0) {
      targetIdx = idx - 1;
    } else if (sectionIdx > 0) {
      const $prevLinks = getVisibleRegionLinks($(sections[sectionIdx - 1]));
      if ($prevLinks.length) {
        focusLink($prevLinks.last());
        return;
      }
    } else {
      getTriggers().first().focus();
      return;
    }
  } else if (direction === "down") {
    if (idx + cols < $links.length) {
      targetIdx = idx + cols;
    } else if (sectionIdx + 1 < sections.length) {
      const $nextLinks = getVisibleRegionLinks($(sections[sectionIdx + 1]));
      if ($nextLinks.length) {
        focusLink($nextLinks.eq(Math.min(col, $nextLinks.length - 1)));
        return;
      }
    }
  } else if (direction === "up") {
    if (idx - cols >= 0) {
      targetIdx = idx - cols;
    } else if (sectionIdx > 0) {
      const $prevLinks = getVisibleRegionLinks($(sections[sectionIdx - 1]));
      if ($prevLinks.length) {
        const prevLen = $prevLinks.length;
        const prevRow = Math.floor((prevLen - 1) / cols);
        const prevIdx = Math.min(prevRow * cols + col, prevLen - 1);
        focusLink($prevLinks.eq(prevIdx));
        return;
      }
    } else {
      getTriggers().first().focus();
      return;
    }
  }

  if (targetIdx !== idx) {
    focusLink($links.eq(targetIdx));
  }
}

function navigateModalArrow(direction) {
  if (isMobileViewport()) {
    navigateMobileLinear(direction);
  } else {
    navigateDesktopGrid(direction);
  }
}

function navigateModalItems(direction) {
  if (direction === "first") {
    focusFirstModalItem();
    return;
  }
  if (direction === "last") {
    const $items = getModalNavigableItems();
    if ($items.length) {
      focusModalItemAt($items.length - 1);
    }
    return;
  }
  if (direction === "next") {
    navigateModalArrow("down");
  } else if (direction === "prev") {
    navigateModalArrow("up");
  }
}

function positionCountrySelectorModal() {
  if (($(".geo-locator").length > 0) && ($(".geo-locator.hide").length < 1)) {
    const top = $(".geo-locator").outerHeight() + 44 + "px";
    $("#country-selector-modal").css("top", top);
    $(".cs-overlay").css("top", top);
  } else {
    $("#country-selector-modal").css("top", "44px");
    $(".cs-overlay").css("top", "44px");
  }
}

function closeCountrySelectorModal() {
  if (!isModalOpen()) {
    return;
  }

  const $desktopTrigger = $("#nv-cs-item .nav-cs-link");
  const $mobileTrigger = $("#nv-cs-item-mob .nav-cs-link");
  const wasMobile = $("#nv-cs-item-mob-close").is(":visible");

  $("#country-selector-modal").removeClass("cs-active");
  $(".cs-overlay").addClass("hide");
  $("body").removeClass("set-overflow");
  $("#nv-cs-item-mob").removeClass("hide-cs-mob-icon");
  $("#nv-cs-item-mob-close").addClass("hide-cs-mob-icon");
  setTriggerExpanded(false);

  if (wasMobile && $mobileTrigger.length) {
    $mobileTrigger.focus();
  } else if ($desktopTrigger.length) {
    $desktopTrigger.focus();
  }
}

function isSearchNavInteraction(e) {
  return $(e.target).closest(
    "#nv-search-box, #nv-search-box-mobile, #cancel-nv-search-box, .search-main-section, .search_white, .search-form, .search-box-input, .search-box-input-mob, .search-inner-container, .search-outter-container, .search-section, .search-icon-container"
  ).length > 0;
}

function bindCountrySelectorA11y() {
  setupModalA11y();
  enhanceRegionSections();

  $(document).on("keydown", TRIGGER_SELECTOR, function (e) {
    const key = e.key;
    const $trigger = $(this);

    if (
      key === "ArrowDown" ||
      key === "Down" ||
      key === "ArrowRight" ||
      key === "Right"
    ) {
      e.preventDefault();
      if (!isModalOpen()) {
        $trigger.trigger("click");
        setTimeout(focusFirstModalItem, 50);
      } else {
        focusFirstModalItem();
      }
      return;
    }

    if (key === " " || key === "Spacebar" || key === "Enter") {
      e.preventDefault();
      if (isModalOpen()) {
        closeCountrySelectorModal();
      } else {
        $trigger.trigger("click");
        setTimeout(focusFirstModalItem, 50);
      }
    }
  });

  $(document).on("keydown", ".region-title[role='button']", function (e) {
    const key = e.key;
    const $title = $(this);
    const direction = keyToDirection(key);

    if (direction === "down") {
      e.preventDefault();
      if (!$title.hasClass("cs-active")) {
        toggleRegion($title);
      }
      const $firstLink = $title.siblings("ul").find(".country-locale-name a").first();
      if ($firstLink.length) {
        $firstLink.focus();
      }
      return;
    }

    if (direction === "right") {
      e.preventDefault();
      if (!$title.hasClass("cs-active")) {
        toggleRegion($title);
      }
      const $firstLink = $title.siblings("ul").find(".country-locale-name a").first();
      if ($firstLink.length) {
        $firstLink.focus();
      }
      return;
    }

    if (direction === "up" || direction === "left") {
      e.preventDefault();
      const $items = getModalNavigableItems();
      const idx = $items.index($title[0]);
      if (idx > 0) {
        focusModalItemAt(idx - 1);
      } else {
        getTriggers().first().focus();
      }
      return;
    }

    if (key === " " || key === "Spacebar" || key === "Enter") {
      e.preventDefault();
      toggleRegion($title);
    }
  });

  $(document).on("keydown", function (e) {
    if (!isModalOpen()) {
      return;
    }

    const key = e.key;
    const modal = document.getElementById(MODAL_ID);
    if (!modal) {
      return;
    }

    if (key === "Escape") {
      e.preventDefault();
      e.stopPropagation();
      closeCountrySelectorModal();
      return;
    }

    const focusInsideModal = modal.contains(document.activeElement);
    const focusOnTrigger = $(TRIGGER_SELECTOR).is(document.activeElement);

    if (!focusInsideModal && !focusOnTrigger) {
      return;
    }

    const direction = keyToDirection(key);

    if (direction) {
      if (focusOnTrigger && (direction === "down" || direction === "right")) {
        e.preventDefault();
        focusFirstModalItem();
        return;
      }

      if (
        focusInsideModal &&
        !$(e.target).is(".region-title[role='button']")
      ) {
        e.preventDefault();
        navigateModalArrow(direction);
      }
    }

    if (key === "Home" && focusInsideModal) {
      e.preventDefault();
      navigateModalItems("first");
    }

    if (key === "End" && focusInsideModal) {
      e.preventDefault();
      navigateModalItems("last");
    }
  });

  $(window).on("resize.countrySelector", enhanceRegionSections);
}

jsonData.Regions.forEach(function (region, regionIndex) {
  // console.log("Inside forEach: ", region)
  // Create region div
  const regionDiv = $("<div>").addClass("region-section");

  // Create region title
  const regionTitle = $("<div>").text(region["region-title"]).addClass("region-title");
  const svg = '<svg class="n24-icon menu-button caret-down"> <use xlink:href="#n24-caret-down"></use></svg>';

  // Create a list for locales
  const localesList = $("<ul>").attr("id", "cs-region-list-" + regionIndex);

  // Loop through locales and create list items

  var currentPath = window.location.pathname;
  if (currentPath.indexOf("knowledge") >= 0) {
    region.localesKnowledge.forEach(function (locale) {
      const listItem = $("<li>").addClass("country-locale-name");
      const spanItem = $("<span>");
      var link = $("<a>").attr("href", locale.link).attr("title", locale.title).attr("data-clocale", locale.locale).text(locale.title);

      spanItem.append(link);
      listItem.append(spanItem);
      localesList.append(listItem);
    });
  } else {

    region.locales.forEach(function (locale) {
      const listItem = $("<li>").addClass("country-locale-name");
      const spanItem = $("<span>");
      const dynamicLocale = isGeForceNowPage && locale.geforceNowLocale
        ? locale.geforceNowLocale
        : locale.locale;
      const dynamicLink = alternateLocaleLinks[dynamicLocale];
      const isExpectedDynamicLink = dynamicLink && dynamicLink.indexOf('/' + dynamicLocale + '/') !== -1;
      const href = isExpectedDynamicLink
        ? dynamicLink
        : (isGeForceNowPage && locale.geforceNowLink ? locale.geforceNowLink : locale.link);
      var link = $("<a>").attr("href", href).attr("title", locale.title).attr("data-clocale", dynamicLocale).text(locale.title);
      spanItem.append(link);
      listItem.append(spanItem);
      localesList.append(listItem);


    });
  }

  // Append region title and locales list to the region div
  // regionDiv.append(emptyDiv)
  regionDiv.append(regionTitle);
  if ($(window).width() <= 1023) {
    regionTitle.append(svg);
  }
  // regionDiv.append(emptyDiv)
  regionDiv.append(localesList);

  // Append the region div to the container
  $("#cs-end").before(regionDiv);
});

